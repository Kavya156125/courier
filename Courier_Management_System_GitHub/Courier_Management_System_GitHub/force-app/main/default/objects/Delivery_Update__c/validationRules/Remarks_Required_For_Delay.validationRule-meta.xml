<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
  <fullName>Remarks_Required_For_Delay</fullName>
  <active>true</active>
  <errorConditionFormula>AND(ISPICKVAL(Status__c, "Delayed"), ISBLANK(Remarks__c))</errorConditionFormula>
  <errorMessage>Remarks are required when status is Delayed.</errorMessage>
</ValidationRule>
